{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://admissions-os.local/schemas/onboarding/02-fact-extraction.schema.json",
  "title": "Stage 2 - Fact Extraction Contract",
  "type": "object",
  "required": [
    "input",
    "output"
  ],
  "$defs": {
    "candidateEntity": {
      "type": "object",
      "required": [
        "temporary_entity_id",
        "entity_type",
        "entity_name"
      ],
      "properties": {
        "temporary_entity_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_type": {
          "type": "string",
          "enum": [
            "institution",
            "programme",
            "fee",
            "intake",
            "requirement",
            "application_step",
            "faq_policy",
            "contact_location",
            "scholarship"
          ]
        },
        "entity_name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "parent_temporary_entity_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "context": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "required": [
        "fact_id",
        "temporary_entity_id",
        "entity_type",
        "field_name",
        "raw_value",
        "source_evidence",
        "confidence"
      ],
      "properties": {
        "fact_id": {
          "type": "string",
          "minLength": 1
        },
        "temporary_entity_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_type": {
          "type": "string",
          "enum": [
            "institution",
            "programme",
            "fee",
            "intake",
            "requirement",
            "application_step",
            "faq_policy",
            "contact_location",
            "scholarship"
          ]
        },
        "field_name": {
          "type": "string",
          "minLength": 1
        },
        "raw_value": {},
        "normalized_candidate": {},
        "source_evidence": {
          "type": "string",
          "minLength": 1
        },
        "evidence_locator": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "input": {
      "type": "object",
      "required": [
        "tenant_id",
        "institution_id",
        "onboarding_run_id",
        "source_id",
        "page_type",
        "information_types_found",
        "content"
      ],
      "properties": {
        "tenant_id": {
          "$ref": "00-common.schema.json#/$defs/tenantId"
        },
        "institution_id": {
          "$ref": "00-common.schema.json#/$defs/institutionId"
        },
        "onboarding_run_id": {
          "$ref": "00-common.schema.json#/$defs/onboardingRunId"
        },
        "source_id": {
          "$ref": "00-common.schema.json#/$defs/sourceId"
        },
        "page_type": {
          "type": "string",
          "enum": [
            "institution",
            "programme",
            "programme_list",
            "fees",
            "admissions",
            "requirements",
            "intakes",
            "application",
            "faq",
            "policy",
            "contact",
            "scholarship",
            "campus",
            "accommodation",
            "international_students",
            "mixed",
            "general",
            "other",
            "irrelevant"
          ]
        },
        "information_types_found": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "institution",
              "programme",
              "fee",
              "intake",
              "requirement",
              "application",
              "scholarship",
              "faq",
              "policy",
              "contact",
              "location",
              "accommodation",
              "international_students",
              "other"
            ]
          }
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "page_title": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [
        "status",
        "source_id",
        "entities",
        "facts",
        "warnings",
        "errors"
      ],
      "properties": {
        "status": {
          "$ref": "00-common.schema.json#/$defs/stageStatus"
        },
        "source_id": {
          "$ref": "00-common.schema.json#/$defs/sourceId"
        },
        "entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/candidateEntity"
          }
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "00-common.schema.json#/$defs/error"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}