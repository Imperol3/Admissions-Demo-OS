{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://admissions-os.local/schemas/onboarding/05-contact-location.schema.json",
  "title": "Canonical Contact or Location",
  "type": "object",
  "required": [
    "tenant_id",
    "institution_id",
    "onboarding_run_id",
    "source_id",
    "source_evidence",
    "is_current",
    "data_status",
    "review_status",
    "record_id",
    "record_type",
    "name"
  ],
  "properties": {
    "tenant_id": {
      "$ref": "00-common.schema.json#/$defs/tenantId"
    },
    "institution_id": {
      "$ref": "00-common.schema.json#/$defs/institutionId"
    },
    "onboarding_run_id": {
      "$ref": "00-common.schema.json#/$defs/onboardingRunId"
    },
    "source_id": {
      "$ref": "00-common.schema.json#/$defs/sourceId"
    },
    "source_evidence": {
      "type": "string",
      "minLength": 1
    },
    "valid_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "valid_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "is_current": {
      "type": "boolean"
    },
    "data_status": {
      "$ref": "00-common.schema.json#/$defs/dataStatus"
    },
    "review_status": {
      "$ref": "00-common.schema.json#/$defs/reviewStatus"
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "record_id": {
      "type": "string"
    },
    "record_type": {
      "type": "string",
      "enum": [
        "contact",
        "location"
      ]
    },
    "contact_or_location_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string"
    },
    "role_or_department": {
      "type": [
        "string",
        "null"
      ]
    },
    "email": {
      "type": [
        "string",
        "null"
      ],
      "format": "email"
    },
    "phone": {
      "type": [
        "string",
        "null"
      ]
    },
    "website_or_booking_url": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "address_line": {
      "type": [
        "string",
        "null"
      ]
    },
    "city": {
      "type": [
        "string",
        "null"
      ]
    },
    "region": {
      "type": [
        "string",
        "null"
      ]
    },
    "country": {
      "type": [
        "string",
        "null"
      ]
    },
    "campus": {
      "type": [
        "string",
        "null"
      ]
    },
    "opening_hours": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}