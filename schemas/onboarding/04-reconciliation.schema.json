{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://admissions-os.local/schemas/onboarding/04-reconciliation.schema.json",
  "title": "Stage 4 - Normalization and Reconciliation Contract",
  "type": "object",
  "required": [
    "input",
    "output"
  ],
  "properties": {
    "input": {
      "type": "object",
      "required": [
        "tenant_id",
        "institution_id",
        "onboarding_run_id",
        "canonical_entity_id",
        "entity_type",
        "field_name",
        "observations"
      ],
      "properties": {
        "tenant_id": {
          "$ref": "00-common.schema.json#/$defs/tenantId"
        },
        "institution_id": {
          "$ref": "00-common.schema.json#/$defs/institutionId"
        },
        "onboarding_run_id": {
          "$ref": "00-common.schema.json#/$defs/onboardingRunId"
        },
        "canonical_entity_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_type": {
          "type": "string",
          "enum": [
            "institution",
            "programme",
            "fee",
            "intake",
            "requirement",
            "application_step",
            "faq_policy",
            "contact_location",
            "scholarship"
          ]
        },
        "field_name": {
          "type": "string",
          "minLength": 1
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "fact_id",
              "source_id",
              "raw_value",
              "source_evidence"
            ],
            "properties": {
              "fact_id": {
                "type": "string"
              },
              "source_id": {
                "$ref": "00-common.schema.json#/$defs/sourceId"
              },
              "raw_value": {},
              "normalized_candidate": {},
              "source_evidence": {
                "type": "string"
              },
              "authority_level": {
                "$ref": "00-common.schema.json#/$defs/authorityLevel"
              },
              "effective_from": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "effective_to": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "observed_at": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [
        "status",
        "resolution_status",
        "canonical_entity_id",
        "field_name",
        "supporting_fact_ids",
        "conflict",
        "requires_human_review",
        "warnings",
        "errors"
      ],
      "properties": {
        "status": {
          "$ref": "00-common.schema.json#/$defs/stageStatus"
        },
        "resolution_status": {
          "type": "string",
          "enum": [
            "resolved",
            "conflicting",
            "needs_review",
            "rejected",
            "not_published",
            "not_applicable",
            "expired"
          ]
        },
        "canonical_entity_id": {
          "type": "string"
        },
        "field_name": {
          "type": "string"
        },
        "canonical_value": {},
        "supporting_fact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rejected_fact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflict": {
          "type": "boolean"
        },
        "conflict_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "requires_human_review": {
          "type": "boolean"
        },
        "decision_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "00-common.schema.json#/$defs/error"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}