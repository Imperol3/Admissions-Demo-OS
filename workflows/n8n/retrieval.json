    {
      "id": "29a05e24-ba4a-4315-bfd2-36d5058cf015",
      "name": "Execute a SQL query",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "queryReplacement": "={{ '[' + $json.data[0].embedding.join(',') + ']' }}, {{ $('Edit Fields').item.json.tenant_id }}"
        },
        "query": "SELECT\n    id,\n    institution_id,\n    category,\n    content,\n    metadata,\n    1 - (embedding <=> $1::vector) AS score\n\nFROM demo_chunk_staging\n\nWHERE institution_id = $2\n  AND embedding IS NOT NULL\n\nORDER BY embedding <=> $1::vector\n\nLIMIT 5;"
      },
      "position": [
        688,
        0
      ],
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7
    },
    {
      "id": "e1b3ab1c-6a76-4ee0-86b0-a35ed57f5500",
      "name": "Prepare Context",
      "parameters": {
        "jsCode": "const chunks = $input.all();\n\nconst context = chunks\n  .map((item, i) => {\n    const c = item.json;\n\n    return [\n      `SOURCE ${i + 1}`,\n      `Category: ${c.category || 'unknown'}`,\n      `Score: ${c.score ?? 'unknown'}`,\n      `Content: ${c.content}`\n    ].join('\\n');\n  })\n  .join('\\n\\n');\n\nreturn [{\n  json: {\n    context\n  }\n}];"
      },
      "position": [
        1184,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
