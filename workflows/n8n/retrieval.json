        "jsonBody": "={\n  \"model\": \"openai/text-embedding-3-small\",\n  \"input\": \n    {{ $json.query.toJsonString()}}\n  ,\n  \"dimensions\": 1536\n}",
        "method": "POST",
        "nodeCredentialType": "openRouterApi",
